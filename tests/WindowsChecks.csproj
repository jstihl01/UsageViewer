<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Compile Include="WindowsChecks.cs" />
    <Compile Include="../src/TrayIndicator.cs" Link="TrayIndicator.cs" />
    <Compile Include="../src/Native.cs" Link="Native.cs" />
    <Compile Include="../src/RingsView.cs" Link="RingsView.cs" />
    <Compile Include="../src/Usage.cs" Link="Usage.cs" />
  </ItemGroup>
</Project>
