<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/UsageViewer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/UsageViewer.ico" />
    <EmbeddedResource Include="../dependencies.json" Link="dependencies.json" />
    <ProjectReference Include="../Core/UsageViewer.Core.csproj" />
    <ProjectReference Include="../Platform/UsageViewer.Windows.csproj" />
    <InternalsVisibleTo Include="UsageViewer.Windows.Tests" />
  </ItemGroup>
</Project>
